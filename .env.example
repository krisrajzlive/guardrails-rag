# OpenAI key: used for generation always, and for the guard engine when
# GUARD_ENGINE=openai_moderation (default, hosted, no local model download).
OPENAI_API_KEY=

# HuggingFace token: needed for the hosted prompt-injection classifier
# (protectai/deberta-v3-base-prompt-injection-v2 is ungated -- this token is
# only for API auth, no license to accept). Also used if you switch
# GUARD_ENGINE to llama_guard (same token works for both).
HF_TOKEN=

# Overrides (optional)
GUARD_ENGINE=openai_moderation
GUARD_MODEL_ID=meta-llama/Llama-Guard-3-1B
MODERATION_MODEL=omni-moderation-latest
INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_THRESHOLD=0.75
GEN_MODEL=gpt-4o-mini
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
